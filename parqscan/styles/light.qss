* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #172033;
    selection-background-color: #258BFF;
    selection-color: #FFFFFF;
}
QWidget {
    background: transparent;
}
QMainWindow, QDialog {
    background: #F6F8FC;
}
QLabel {
    background: transparent;
    border: none;
}
QAbstractScrollArea::viewport {
    background: transparent;
}
QToolTip, QLabel#ImageTooltip {
    background: #FFFFFF;
    color: #172033;
    border: 1px solid #D9E1EC;
    border-radius: 9px;
    padding: 8px;
}
QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E7EBF2;
    padding: 5px 12px;
}
QMenuBar::item {
    background: transparent;
    border-radius: 7px;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background: #EEF5FF;
    color: #0F6FDB;
}
QMenu {
    background: #FFFFFF;
    border: 1px solid #DDE4EE;
    border-radius: 10px;
    padding: 7px;
}
QMenu::item {
    border-radius: 7px;
    padding: 8px 30px 8px 12px;
}
QMenu::item:selected {
    background: #EAF4FF;
    color: #0F6FDB;
}
QMenu::item:disabled {
    color: #A5AFBE;
}
QMenu::separator {
    height: 1px;
    background: #E8EDF4;
    margin: 6px 8px;
}
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E6EAF1;
    padding: 3px 10px;
}
QStatusBar QLabel {
    color: #667085;
    padding: 0 9px;
}
QFrame#Sidebar {
    background: #FBFCFE;
    border-right: 1px solid #E5EAF1;
}
QSplitter#MainSplitter::handle {
    background: #E5EAF1;
    width: 1px;
}
QLabel#BrandMark {
    background: #258BFF;
    color: #FFFFFF;
    border-radius: 11px;
    font-weight: 800;
    font-size: 14px;
}
QLabel#BrandTitle {
    font-size: 17px;
    font-weight: 750;
    color: #101828;
}
QLabel#PageTitle {
    font-size: 24px;
    font-weight: 760;
    color: #101828;
}
QLabel#DialogTitle {
    font-size: 20px;
    font-weight: 740;
    color: #101828;
}
QLabel#FieldTitle {
    font-size: 18px;
    font-weight: 720;
    color: #101828;
}
QLabel#SectionTitle, QLabel#EmptyTitle {
    font-size: 15px;
    font-weight: 700;
    color: #172033;
}
QLabel#EyebrowLabel {
    color: #258BFF;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 1px;
}
QLabel#MutedLabel, QLabel#PathLabel, QLabel#PaginationTotal {
    color: #667085;
}
QLabel#PathLabel {
    font-family: "Cascadia Mono", "Consolas", monospace;
}
QLabel#Chip {
    background: #EDF5FF;
    color: #0F6FDB;
    border: 1px solid #D7E9FF;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 650;
}
QFrame#Card, QFrame#ToolbarCard, QFrame#TableCard, QFrame#MetricCard,
QFrame#PathCard, QFrame#PaginationBar, QFrame#DialogHeader,
QFrame#LoadingCard, QFrame#EmptyState {
    background: #FFFFFF;
    border: 1px solid #E3E8F0;
    border-radius: 13px;
}
QFrame#ToolbarCard {
    border-radius: 11px;
}
QFrame#TableCard {
    border-radius: 13px;
}
QFrame#PathCard {
    background: #FFFFFF;
}
QFrame#MetricCard {
    min-height: 68px;
}
QFrame#MetricAccent {
    background: #258BFF;
    border: none;
    border-radius: 2px;
}
QLabel#MetricTitle {
    color: #667085;
    font-size: 11px;
    font-weight: 650;
}
QLabel#MetricValue {
    color: #101828;
    font-size: 20px;
    font-weight: 760;
}
QFrame#LoadingCard {
    min-width: 348px;
    border-color: #CFE3FF;
}
QWidget#LoadingOverlay {
    background: rgba(246, 248, 252, 222);
}
QLabel#LoadingTitle {
    color: #101828;
    font-size: 16px;
    font-weight: 720;
}
QPushButton, QToolButton {
    min-height: 34px;
    background: #FFFFFF;
    border: 1px solid #D7DFEA;
    border-radius: 9px;
    padding: 0 14px;
    font-weight: 620;
}
QPushButton:hover, QToolButton:hover {
    background: #F4F7FB;
    border-color: #B8C4D3;
}
QPushButton:pressed, QToolButton:pressed {
    background: #E9EEF5;
}
QPushButton:disabled, QToolButton:disabled {
    color: #A7B1C0;
    background: #F6F8FA;
    border-color: #E8ECF1;
}
QPushButton[primary="true"] {
    background: #258BFF;
    color: #FFFFFF;
    border-color: #258BFF;
}
QPushButton[primary="true"]:hover {
    background: #147BE8;
    border-color: #147BE8;
}
QPushButton[secondary="true"] {
    background: #EEF5FF;
    color: #0F6FDB;
    border-color: #D5E8FF;
}
QPushButton[secondary="true"]:hover {
    background: #E2EFFF;
}
QPushButton[ghost="true"] {
    background: transparent;
    border-color: transparent;
    color: #667085;
}
QPushButton[ghost="true"]:hover {
    background: #EEF2F7;
    color: #172033;
}
QToolButton[nav="true"] {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    background: transparent;
    border-color: transparent;
}
QToolButton[nav="true"]:hover {
    background: #EDF3FA;
    border-color: transparent;
}
QLineEdit, QComboBox {
    min-height: 34px;
    background: #FFFFFF;
    border: 1px solid #D7DFEA;
    border-radius: 9px;
    padding: 0 10px;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #258BFF;
    padding-left: 9px;
}
QLineEdit:disabled, QComboBox:disabled {
    background: #F6F8FA;
    color: #A7B1C0;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DDE4EE;
    border-radius: 8px;
    padding: 5px;
    selection-background-color: #EAF4FF;
    selection-color: #0F6FDB;
}
QFrame#PageNavigation {
    background: #F7F9FC;
    border: 1px solid #E4E9F0;
    border-radius: 10px;
}
QLineEdit#PageNumberEdit {
    min-height: 30px;
    max-height: 30px;
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 7px;
    padding: 0 5px;
    font-weight: 700;
}
QLabel#PaginationSummary {
    color: #475467;
    font-weight: 620;
}
QProgressBar {
    height: 7px;
    background: #E9EFF7;
    border: none;
    border-radius: 3px;
}
QProgressBar::chunk {
    background: #258BFF;
    border-radius: 3px;
}
QTableView, QTableWidget, QTreeWidget, QListWidget, QPlainTextEdit {
    background: #FFFFFF;
    alternate-background-color: #F8FAFD;
    border: 1px solid #E3E8F0;
    border-radius: 9px;
    gridline-color: transparent;
    outline: none;
}
QTableView::item, QTableWidget::item, QTreeWidget::item, QListWidget::item {
    padding: 8px 10px;
    border: none;
}
QTableView::item:selected, QTableWidget::item:selected,
QTreeWidget::item:selected, QListWidget::item:selected {
    background: #DCEEFF;
    color: #0F5FB8;
}
QTableView::item:hover, QTableWidget::item:hover,
QTreeWidget::item:hover, QListWidget::item:hover {
    background: #F0F6FD;
}
QTableView#DataTable {
    border: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
QListWidget#FileList {
    background: transparent;
    border: none;
}
QListWidget#FileList::item {
    border-radius: 9px;
    padding: 10px 11px;
    margin: 2px 0;
}
QListWidget#FileList::item:selected {
    background: #E7F2FF;
    color: #0F6FDB;
    font-weight: 650;
}
QListWidget#FieldList::item {
    border-radius: 8px;
    margin: 2px 0;
}
QHeaderView::section {
    background: #F4F6F9;
    color: #475569;
    border: none;
    border-right: 1px solid #E5EAF1;
    border-bottom: 1px solid #DDE4ED;
    padding: 10px 12px;
    font-weight: 700;
}
QTableCornerButton::section {
    background: #F4F6F9;
    border: none;
    border-right: 1px solid #E5EAF1;
    border-bottom: 1px solid #DDE4ED;
}
QTabWidget::pane {
    border: none;
    background: transparent;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #667085;
    border: none;
    border-radius: 9px;
    padding: 9px 15px;
    margin: 4px 3px;
    font-weight: 650;
}
QTabBar::tab:hover {
    background: #EEF2F7;
    color: #172033;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0F6FDB;
    border: 1px solid #DDE6F2;
}
QTabWidget#DocumentTabs > QTabBar::tab {
    margin-top: 7px;
}
QPlainTextEdit#DetailEditor, QPlainTextEdit#CodeEditor {
    font-family: "Cascadia Mono", "Consolas", monospace;
    padding: 14px;
    selection-background-color: #B9DDFF;
    selection-color: #101828;
}
QScrollArea#ImageCanvas {
    background: #F3F6FA;
    border: 1px solid #DDE5EF;
    border-radius: 11px;
}
QSplitter::handle {
    background: transparent;
}
QSplitter::handle:horizontal {
    width: 7px;
}
QSplitter::handle:vertical {
    height: 7px;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 1px;
}
QScrollBar::handle:vertical {
    background: #C7D0DC;
    min-height: 28px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #9EACBC;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 1px 2px;
}
QScrollBar::handle:horizontal {
    background: #C7D0DC;
    min-width: 28px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #9EACBC;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}
QMessageBox, QProgressDialog {
    background: #F6F8FC;
}
QFrame#EmptyState {
    margin: 26px;
}
QPushButton[toggle="true"] {
    min-height: 30px;
    background: #F7F9FC;
    color: #667085;
    border-color: #E1E7EF;
    padding: 0 10px;
}
QPushButton[toggle="true"]:checked {
    background: #E7F2FF;
    color: #0F6FDB;
    border-color: #C9E1FF;
}

/* Refined compact navigation and hint layer */
QToolTip, QLabel#CompactTooltip, QLabel#ImageTooltip {
    background: #172033;
    color: #FFFFFF;
    border: 1px solid #172033;
    border-radius: 6px;
    padding: 4px 7px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#CompactTooltip {
    min-width: 0;
    min-height: 0;
}
QFrame#PaginationBar {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #E3E8F0;
    border-radius: 0;
}
QFrame#PageNavigation {
    background: transparent;
    border: none;
}
QToolButton[paginationNav="true"] {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    background: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 8px;
}
QToolButton[paginationNav="true"]:hover {
    background: #EEF6FF;
    border-color: #BFD9FA;
}
QToolButton[paginationNav="true"]:pressed {
    background: #E1EFFF;
}
QToolButton[paginationNav="true"]:disabled {
    background: #F8FAFC;
    border-color: #EEF1F5;
}
QLineEdit#PageNumberEdit {
    min-height: 28px;
    max-height: 28px;
    border-radius: 8px;
    padding: 0 5px;
}
QLabel#PaginationTotal {
    color: #667085;
    font-size: 12px;
}
QFrame#HexToolbar {
    background: #FFFFFF;
    border: 1px solid #E3E8F0;
    border-radius: 11px;
}
QLabel#HexInfoLabel {
    color: #667085;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}
QLineEdit#HexSearchEdit {
    min-height: 32px;
}
QPlainTextEdit#CodeEditor {
    background: #FFFFFF;
    border: 1px solid #E3E8F0;
    border-radius: 11px;
    padding: 14px 16px;
}
QTableView#SchemaTable, QTreeWidget#RowGroupTree {
    border-radius: 11px;
}
QStatusBar {
    min-height: 22px;
    max-height: 24px;
}

/* Unified dense-surface and search controls */
QMenu {
    border-radius: 0;
    padding: 5px;
}
QMenu::item {
    border-radius: 5px;
}
QFrame#Card, QFrame#ToolbarCard, QFrame#MetricCard, QFrame#PathCard,
QFrame#DialogHeader, QFrame#LoadingCard, QFrame#EmptyState, QFrame#HexToolbar {
    border-radius: 10px;
}
QFrame#TableCard {
    background: transparent;
    border: none;
    border-radius: 0;
}
QTableView#DataTable {
    background: #FFFFFF;
    border: 1px solid #E3E8F0;
    border-radius: 0;
}
QFrame#PaginationBar {
    background: #FFFFFF;
    border: 1px solid #E3E8F0;
    border-top: none;
    border-radius: 0;
}
QFrame#SearchField {
    min-height: 34px;
    max-height: 34px;
    background: #FFFFFF;
    border: 1px solid #D7DFEA;
    border-radius: 9px;
}
QFrame#SearchField[focused="true"] {
    border: 2px solid #258BFF;
}
QFrame#SearchField QLabel#SearchFieldIcon {
    background: transparent;
    border: none;
}
QFrame#SearchField QLineEdit#SearchFieldEdit {
    min-height: 30px;
    max-height: 30px;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}
QFrame#SearchField QLineEdit#SearchFieldEdit:focus {
    border: none;
    padding: 0;
}
QToolButton[paginationNav="true"] {
    min-width: 0;
    min-height: 32px;
    max-height: 32px;
    background: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 7px;
    padding: 0 10px;
    font-weight: 620;
}
QToolButton[paginationNav="true"]:hover {
    background: #EEF6FF;
    border-color: #BFD9FA;
    color: #0F6FDB;
}
QToolButton[paginationNav="true"]:disabled {
    background: #F8FAFC;
    border-color: #EEF1F5;
    color: #A7B1C0;
}
QToolButton[hexNav="true"] {
    min-width: 76px;
    min-height: 32px;
    max-height: 32px;
    background: #F7F9FC;
    border: 1px solid #DCE3ED;
    border-radius: 7px;
    padding: 0 10px;
}
QToolButton[hexNav="true"]:hover {
    background: #EEF6FF;
    border-color: #BFD9FA;
}
QToolButton[hexNav="true"]:disabled {
    background: #F8FAFC;
    border-color: #EEF1F5;
    color: #A7B1C0;
}
QLabel#HexPurposeLabel {
    color: #667085;
    font-size: 12px;
}
QLabel#SearchStatus {
    color: #667085;
    font-size: 11px;
    font-family: "Cascadia Mono", "Consolas", monospace;
}
QComboBox#HexSearchMode {
    min-height: 34px;
}
QStackedWidget#HexContentStack {
    background: transparent;
    border: none;
}
QFrame#HexEmptyState {
    margin: 0;
}
QAbstractScrollArea::corner, QWidget#ScrollCorner {
    background: #FFFFFF;
    border: none;
}
QScrollBar:vertical {
    margin: 0;
}
QScrollBar:horizontal {
    margin: 0;
}
QToolTip {
    border-radius: 3px;
    padding: 4px 6px;
    font-size: 11px;
}

/* Popup clipping and final rounded-surface consistency */
QMenu#RoundedMenu {
    background: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 10px;
    padding: 6px;
}
QMenu#RoundedMenu::item {
    min-height: 30px;
    padding: 5px 24px 5px 12px;
    border-radius: 7px;
}
QMenu#RoundedMenu::item:selected {
    background: #EAF4FF;
    color: #0F6FDB;
}
QComboBox {
    padding-right: 30px;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}
QComboBox#PageSizeCombo {
    min-width: 74px;
    max-width: 74px;
    padding-left: 12px;
    padding-right: 30px;
    font-weight: 620;
}
QListView#RoundedComboPopup {
    background: #FFFFFF;
    color: #172033;
    border: 1px solid #DCE3ED;
    border-radius: 10px;
    padding: 5px;
    outline: none;
}
QListView#RoundedComboPopup::item {
    min-height: 30px;
    padding: 3px 9px;
    border-radius: 7px;
}
QListView#RoundedComboPopup::item:selected,
QListView#RoundedComboPopup::item:hover {
    background: #EAF4FF;
    color: #0F6FDB;
}
QTableView#DataTable {
    border: 1px solid #E3E8F0;
    border-radius: 10px;
}
QFrame#PaginationBar {
    border: 1px solid #E3E8F0;
    border-radius: 10px;
}
QToolButton[paginationNav="true"] {
    min-width: 34px;
    max-width: 34px;
    padding: 0;
    border-radius: 8px;
}
QPushButton[hexNav="true"] {
    min-width: 88px;
    border-radius: 8px;
}
QDialog#MessageDialog {
    background: #F4F7FB;
}
QFrame#MessageCard {
    background: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 12px;
}
QLabel#MessageIcon, QLabel#MessageIconCritical {
    background: #EAF4FF;
    color: #0F6FDB;
    border-radius: 19px;
    font-size: 18px;
    font-weight: 700;
}
QLabel#MessageIconCritical {
    background: #FFF0F0;
    color: #D92D20;
}
QLabel#MessageText {
    color: #344054;
    background: transparent;
    padding: 0;
    margin: 0;
}
QScrollArea#ImageCanvas,
QLabel#DetailImage {
    border-radius: 10px;
}
QToolTip {
    border-radius: 7px;
    padding: 5px 8px;
}
QSpinBox {
    min-height: 34px;
    background: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DFEA;
    border-radius: 9px;
    padding: 0 30px 0 10px;
}
QSpinBox:focus {
    border: 2px solid #258BFF;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 24px;
    border: none;
    background: transparent;
}

QLabel#MessageLogo {
    background: transparent;
    border: none;
}
QGraphicsView#ImageCanvas {
    background: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 10px;
    padding: 0;
}
QGraphicsView#ImageCanvas:focus {
    border: 1px solid #B9D9FF;
}
QAbstractScrollArea#ImageCanvas::viewport {
    background: #FFFFFF;
}

/* Unified non-native popup surfaces */
QFrame#RoundedComboPopupWindow {
    background: #FFFFFF;
    border: none;
}
QFrame#FloatingHint {
    background: #172033;
    border: none;
    border-radius: 8px;
}
QLabel#FloatingHintText {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
}
QFrame#ImageHoverCard {
    background: #FFFFFF;
    border: 1px solid #D9E1EC;
    border-radius: 12px;
}
QLabel#ImageHoverPreview {
    background: #F5F8FC;
    border: none;
    border-radius: 9px;
    padding: 4px;
}
QLabel#ImageHoverCaption {
    color: #667085;
    font-size: 12px;
    font-weight: 600;
}
QFrame#DetailPreviewCard {
    background: #FFFFFF;
    border: none;
}
QWidget#DetailPreviewGrid {
    background: #E8EEF6;
    border: none;
}
QWidget#DetailResizeHandle {
    background: transparent;
}
QWidget#DetailResizeHandle:hover {
    background: rgba(37, 139, 255, 55);
}
QFrame#DetailPreviewTile {
    background: #FFFFFF;
    border: none;
    border-radius: 10px;
    color: #8B9CB3;
}
QFrame#DetailDockTitle {
    min-height: 30px;
    max-height: 30px;
    background: #EEF2F7;
    border-bottom: 1px solid #8B9CB3;
}
QLabel#DetailDockTitleLabel {
    color: #344054;
    font-weight: 620;
}
QWidget#DetailDockGrip {
    min-width: 24px;
    max-width: 24px;
    color: #718096;
}
QFrame#DetailSearchBar {
    background: #F8FAFC;
    border: 1px solid #DDE5EF;
    border-radius: 9px;
}
QFrame#DetailSearchBar QFrame#SearchField {
    background: #FFFFFF;
}
QLabel#DetailSearchStatus {
    color: #667085;
    min-width: 110px;
}
QComboBox#FileSortCombo {
    min-height: 30px;
    max-height: 30px;
    font-size: 11px;
}
QListWidget#FieldList::item:selected {
    background: #DCEEFF;
    color: #0F5FB8;
}
QListWidget#FieldList::item:selected:!active {
    background: #E8F2FC;
    color: #0F5FB8;
}
