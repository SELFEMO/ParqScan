Name:           parqscan
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Desktop inspector and converter for Apache Parquet files
License:        Apache-2.0
URL:            https://github.com/SELFEMO/ParqScan

AutoReqProv:    no
%define debug_package %{nil}
%define _build_id_links none

%description
ParqScan is a desktop inspector and converter for Apache Parquet files,
embedded images, and binary attachments. It reads one page at a time
without materializing full datasets into memory.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}/opt/parqscan
mkdir -p %{buildroot}/usr/bin
mkdir -p %{buildroot}/usr/share/applications
mkdir -p %{buildroot}/usr/share/icons/hicolor/scalable/apps
mkdir -p %{buildroot}/usr/share/icons/hicolor/256x256/apps
mkdir -p %{buildroot}/usr/share/mime/packages

cp -a "@SOURCE_DIR@/." %{buildroot}/opt/parqscan/
chmod 0755 %{buildroot}/opt/parqscan/ParqScan
ln -s /opt/parqscan/ParqScan %{buildroot}/usr/bin/parqscan

install -m 0644 "@DESKTOP_FILE@" %{buildroot}/usr/share/applications/parqscan.desktop
install -m 0644 "@MIME_FILE@" %{buildroot}/usr/share/mime/packages/parqscan.xml
install -m 0644 "@ICON_SVG@" %{buildroot}/usr/share/icons/hicolor/scalable/apps/parqscan.svg
install -m 0644 "@ICON_PNG@" %{buildroot}/usr/share/icons/hicolor/256x256/apps/parqscan.png

%post
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

%postun
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

%files
%defattr(-,root,root,-)
/opt/parqscan
/usr/bin/parqscan
/usr/share/applications/parqscan.desktop
/usr/share/mime/packages/parqscan.xml
/usr/share/icons/hicolor/scalable/apps/parqscan.svg
/usr/share/icons/hicolor/256x256/apps/parqscan.png
