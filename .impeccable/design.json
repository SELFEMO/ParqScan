{
  "name": "ParqScan",
  "description": "Cool blue-gray desktop inspector extended to a static marketing and guide site.",
  "colors": {
    "accent": "#0F6FDB",
    "accent-brand": "#258BFF",
    "accent-hover-light": "#0D5EC0",
    "accent-hover-dark": "#47A3FF",
    "accent-soft-light": "#E7F2FF",
    "accent-soft-dark": "#1D3856",
    "accent-text-light": "#0B5FC4",
    "accent-text-dark": "#7DBEFF",
    "bg-light": "#F6F8FC",
    "surface-light": "#FFFFFF",
    "surface-raised-light": "#FBFCFE",
    "surface-muted-light": "#EEF2F7",
    "text-light": "#172033",
    "text-strong-light": "#101828",
    "text-muted-light": "#5A6B82",
    "border-light": "#CBD5E1",
    "border-input-light": "#94A3B8",
    "bg-dark": "#0F1622",
    "surface-dark": "#141E2B",
    "surface-raised-dark": "#1A2433",
    "surface-muted-dark": "#1E2A3A",
    "text-dark": "#E6EDF7",
    "text-strong-dark": "#F8FAFC",
    "text-muted-dark": "#94A3B8",
    "border-dark": "#344154",
    "border-input-dark": "#4B5E78",
    "danger-light": "#D92D20",
    "danger-dark": "#F87171"
  },
  "typography": {
    "body": {
      "fontFamily": "\"Segoe UI\", \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei UI\", \"Noto Sans CJK SC\", sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "display": {
      "fontFamily": "\"Segoe UI\", \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei UI\", \"Noto Sans CJK SC\", sans-serif",
      "fontSize": "24px",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "mono": {
      "fontFamily": "\"Cascadia Mono\", \"SF Mono\", \"Consolas\", \"Noto Sans Mono\", \"Menlo\", monospace"
    }
  },
  "rounded": {
    "card": "12px",
    "toolbar": "10px",
    "control": "8px",
    "brand": "10px",
    "chip": "8px"
  },
  "spacing": {
    "section": "24px",
    "block": "16px",
    "card": "14px",
    "control-gap": "8px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.accent}",
      "textColor": "#FFFFFF",
      "rounded": "{rounded.control}",
      "padding": "0 14px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.accent-soft-light}",
      "textColor": "{colors.accent-text-light}",
      "rounded": "{rounded.control}",
      "padding": "0 14px"
    },
    "card-surface": {
      "backgroundColor": "{colors.surface-light}",
      "textColor": "{colors.text-light}",
      "rounded": "{rounded.card}",
      "padding": "14px"
    }
  }
}
